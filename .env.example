# ════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES - COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES
# ════════════════════════════════════════════════════════════════════════════

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── BASE DE DATOS MYSQL ───────────────────────────────────────────────────────
# Para Azure SQL Database o MySQL en AzureDatabase for MySQL
DB_HOST=your-mysql-server.mysql.database.azure.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user@your-server
DB_PASSWORD=your_secure_password_here

# ── AUTENTICACIÓN JWT ─────────────────────────────────────────────────────────
# Generar con: require('crypto').randomBytes(32).toString('hex')
JWT_SECRET=your_long_random_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ── MICROSOFT ENTRA ID (Azure AD) - SSO/OIDC/SAML ──────────────────────────────
# Obtener de: Azure Portal > Azure Entra ID > App Registrations > Your App
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your_client_secret_here

# OIDC Configuration
# Usar URL de producción en Azure (ej: https://yourapi.azurewebsites.net)
ENTRA_REDIRECT_URI=https://your-app-name.azurewebsites.net/auth/oidc/callback

# SAML 2.0 Configuration
# Descargar certificado de: Azure Portal > Enterprise Apps > Your App > SAML > Certificate
SAML_CALLBACK_URL=https://your-app-name.azurewebsites.net/auth/saml/callback
SAML_ISSUER=your-app-registration-id
SAML_IDP_CERT=-----BEGIN CERTIFICATE-----\nMIIC....\n-----END CERTIFICATE-----

# SCIM 2.0 (para Azure EntraID provisioning automático de usuarios)
# Generar con: require('crypto').randomBytes(32).toString('hex')
SCIM_BEARER_TOKEN=your_scim_bearer_token_here_min_32_chars

# ── SMTP / EMAIL ──────────────────────────────────────────────────────────────
# Puede usar SendGrid, Office 365, Gmail, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
SMTP_FROM=noreply@yourcompany.com

# ── CLOUDINARY (Cloud Storage para uploads) ────────────────────────────────────
# Registrarse en: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── FRONTEND ───────────────────────────────────────────────────────────────────
# URL del frontend para CORS y redirects
FRONTEND_URL=https://your-frontend-app.azurewebsites.net

# ── SCHEDULER (Tareas programadas con cron) ──────────────────────────────────
# En producción con múltiples instancias, deshabilitar o usar Redis lock
ENABLE_SCHEDULER=false
CRON_SCHEDULE=0 8 * * *

# ── CORS / SEGURIDAD ───────────────────────────────────────────────────────────
# Lista de orígenes permitidos (separar con comas si son múltiples)
ALLOWED_ORIGINS=https://your-app-name.azurewebsites.net,https://your-frontend.com

# ── DEBUG ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info
